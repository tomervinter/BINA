DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="replace-with-a-long-random-value"
PORT=4000
# Comma-separated list of allowed origins in production, e.g. https://app.example.com
CORS_ORIGIN=
# Base URL used to build links inside emails (password reset / email verification).
APP_URL=http://localhost:4000
# Postmark server token — when unset, outgoing emails are logged to the console
# instead of actually sent (see src/lib/email.js), so the app works without this.
POSTMARK_API_KEY=
# The "From" address Postmark sends as — must be a verified sender/domain in Postmark.
EMAIL_FROM=
