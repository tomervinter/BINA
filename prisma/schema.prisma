generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users               User[]
  customers           Customer[]
  products            Product[]
  sales               Sale[]
  inventoryRecords    InventoryRecord[]
  holidays            Holiday[]
  seasons             Season[]
  relevanceOverrides  RelevanceOverride[]
  ruleSettings        RuleSetting[]
  productSubstitutes  ProductSubstitute[]
  columnOrders        ColumnOrder[]
  insights            Insight[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  role           String       @default("admin")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // A platform-level operator who can create new organizations and manage users
  // across ALL of them — separate from `role`, which only ever governs admin/member
  // permissions WITHIN this user's own organizationId. Not settable through normal
  // signup; granted either by an existing super-admin or via the one-time
  // bootstrap-superadmin route (only usable while none exists yet).
  isSuperAdmin   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  columnOrders   ColumnOrder[]

  // Email verification — set on every newly-invited user (see users.js /invite),
  // cleared once GET /api/auth/verify-email confirms the token. Only the token's
  // hash is stored, same principle as passwordHash.
  emailVerified          Boolean   @default(true)
  emailVerifyTokenHash   String?   @unique
  emailVerifyExpiresAt   DateTime?

  // Self-service password reset (POST /api/auth/forgot-password + reset-password) —
  // previously the only way to change a user's password was an admin doing it
  // directly via the invite/edit form. Same hash-only-storage principle.
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
}

model Customer {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  customerNumber  String
  name            String
  primaryClass    String?
  customerType    String?
  city            String?
  centralCustomer String?
  status          String       @default("פעיל")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, customerNumber])
  @@index([organizationId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  itemCode       String
  name           String
  type           String?
  superType      String?
  department     String?
  unit           String?
  status         String       @default("פעיל")
  forProcurement String?
  forMarketing   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, itemCode])
  @@index([organizationId])
}

model Sale {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerNumber String
  productCode    String
  date           DateTime
  quantity       Float
  revenue        Float
  weight         Float?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, customerNumber])
  @@index([organizationId, productCode])
  @@index([organizationId, date])
}

model InventoryRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  sku            String
  productName    String?
  date           DateTime
  stock          Float

  @@index([organizationId])
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  year           Int
  fromDate       DateTime
  toDate         DateTime
  daysBefore     Int          @default(0)
  daysAfter      Int          @default(0)

  @@index([organizationId])
}

model Season {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  year           Int
  fromDate       DateTime
  toDate         DateTime

  @@index([organizationId])
}

model RelevanceOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productCode    String
  source         String
  name           String
  value          Boolean

  @@unique([organizationId, productCode, source, name])
  @@index([organizationId])
}

// A generated snapshot of one insight. Insights are NOT computed live on every
// page load — they're computed by an explicit "יצירת תובנות" action (see
// src/routes/insights.js), which replaces whatever was previously stored. This
// lets a user clear the board mid-day and re-run generation on their own schedule.
model Insight {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  severity       String
  customerId     String?
  customerName   String?
  productCode    String?
  message        String
  metric         Float
  breakdown      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model RuleSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  paramId        String
  value          Float

  @@unique([organizationId, paramId])
  @@index([organizationId])
}

// A directional suggestion: productCode can be substituted BY substituteCode when
// out of stock. Not symmetric — A may substitute for B without B substituting for A.
model ProductSubstitute {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productCode    String
  substituteCode String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, productCode, substituteCode])
  @@index([organizationId])
}

// Per-user column order for a given table, saved as a JSON array of column keys.
// A user with no saved row falls back to the organization admin's saved order for
// that table (the "default" a reset reverts to), and failing that, the page's own
// hardcoded column order.
model ColumnOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  tableKey       String
  order          String
  updatedAt      DateTime     @updatedAt

  @@unique([userId, tableKey])
  @@index([organizationId, tableKey])
}
